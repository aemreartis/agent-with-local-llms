# vLLM Server Dockerfile (Development Version)
FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies including build tools
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy vLLM requirements
COPY vllm/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install vLLM (CPU version for development)
RUN pip install --no-cache-dir vllm

# Create non-root user
RUN useradd --create-home --shell /bin/bash vllm && \
    chown -R vllm:vllm /app
USER vllm

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Run vLLM server (CPU mode)
CMD ["python", "-m", "vllm.entrypoints.openai.api_server", "--host", "0.0.0.0", "--port", "8001", "--model", "microsoft/DialoGPT-medium"] 